{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "typeRoots": ["./apps/browser-extension/node_modules/@types"],
    "paths": {
      "@obs-playing/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["apps/browser-extension/**/*.ts", "packages/shared/src/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/build/**", "**/dist/**"]
}
